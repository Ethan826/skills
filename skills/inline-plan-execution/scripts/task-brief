#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# The brief opens with the plan's Global Constraints section, copied
# verbatim, because those constraints bind every task and the implementer
# never reads the whole plan. A plan with no constraints heading gets a
# brief that says so. A constraints heading this script cannot place (a
# second "Global Constraints", one with no content, or any other heading
# before the first task that mentions constraints) is an error: the
# controller fixes the plan or carries the constraints into the dispatch
# by hand, rather than sending a brief without them.
#
# This file ships identically in subagent-plan-execution/scripts and
# inline-plan-execution/scripts, so each skill installs on its own. Change
# both copies together.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
# Exit: 0 brief written; 2 usage; 3 task not found; 4 constraints heading
# cannot be parsed.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
case "$n" in
  ''|*[!0-9]*) echo "TASK_NUMBER must be a number: $n" >&2; exit 2 ;;
esac

if [ $# -eq 3 ]; then
  out=$3
else
  # Invoke via bash rather than direct exec: some extractors (Python zipfile)
  # strip Unix exec bits when unpacking packaged skills.
  dir=$("${BASH:-bash}" "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

rc=0
awk -v n="$n" -v plan="$plan" '
  function fail(code, msg) {
    print "task-brief: " msg > "/dev/stderr"
    failed = code
    exit code
  }
  function title(line) {
    sub(/^#+[ \t]+/, "", line)
    sub(/[ \t#]+$/, "", line)
    return line
  }
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+/ {
    match($0, /^#+/)
    level = RLENGTH
    if ($0 ~ /^#+[ \t]+Task[ \t]+[0-9]+/) {
      seentask = 1
      incons = 0
      intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
      if (intask) found = 1
    } else if (!seentask && !(incons && level > conslevel)) {
      # Any heading at or above the constraints heading ends the section;
      # deeper headings are its subsections and stay in it.
      incons = 0
      if (tolower(title($0)) ~ /constraint/) {
        if (tolower(title($0)) != "global constraints")
          fail(4, plan ":" NR ": cannot place constraints heading \"" title($0) "\" (task-brief reads only \"Global Constraints\"); rename it, or fold it into Global Constraints")
        if (hascons)
          fail(4, plan ":" NR ": second \"Global Constraints\" heading (first at line " consline ")")
        hascons = 1
        incons = 1
        conslevel = level
        consline = NR
        next
      }
    }
  }
  # A horizontal rule ends the plan header, and with it the constraints.
  !infence && !seentask && incons && /^(---+|\*\*\*+|___+)[ \t]*$/ { incons = 0 }
  incons {
    cons = cons $0 "\n"
    if ($0 ~ /[^ \t]/) consbody = 1
  }
  intask { task = task $0 "\n" }
  END {
    if (failed) exit failed
    if (hascons && !consbody)
      fail(4, plan ":" consline ": \"Global Constraints\" heading has no content; write \"None\" if the plan has none")
    if (!found) exit 3
    print "## Global Constraints (from the plan; they bind this task)"
    print ""
    if (hascons) {
      sub(/^\n+/, "", cons)
      sub(/\n+$/, "\n", cons)
      printf "%s", cons
    } else {
      print "The plan has no Global Constraints section."
    }
    print ""
    printf "%s", task
  }
' "$plan" > "$out" || rc=$?

if [ "$rc" -ne 0 ]; then
  rm -f "$out"  # leave no partial brief behind to be mistaken for a real one
  if [ "$rc" -eq 3 ]; then
    echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  fi
  exit "$rc"
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
