#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# The brief opens with the plan's Global Constraints section, copied
# verbatim, because those constraints bind every task and the implementer
# never reads the whole plan. A plan with no constraints heading gets a
# brief that says so. A constraints heading this script cannot place (a
# second "Global Constraints", one with no content, or any other heading
# before the first task that mentions constraints) is an error: the
# controller fixes the plan or carries the constraints into the dispatch
# by hand, rather than sending a brief without them.
#
# A task heading is `Task` followed by an ID: letters and digits, optionally
# dot-separated, containing at least one digit (3, 6b, A1, 2.1). The digit
# keeps headings like "## Task Overview" or "#### Task notes" from becoming
# task boundaries. The ID is compared to TASK_NUMBER as a whole string, so
# Task 6 never matches Task 6b and Task 1 never matches Task 1.1. A deeper
# Task heading whose ID extends the requested one with a letter or dot is a
# sub-task and stays in its brief (### Task 7 keeps #### Task 7a). Depth
# alone is not enough: plans drift from "## Task 1" to "### Task 2".
#
# The word stays the English literal "Task", whatever language the rest of
# the plan is in. A plan with no Task headings at all usually translated it
# ("## Tarea 1"), so the script lists the headings shaped like tasks before
# the not-found error instead of implying the plan has no task 1.
#
# A code fence that never closes hides every Task heading after it. When it
# hides one while the requested task is being captured, that task's end
# can't be found and the brief would run on through every later task: the
# script refuses (exit 5) rather than hand an implementer several tasks as
# its requirements. When it hides the requested heading itself, the script
# says so before the not-found error (exit 3). A stray fence that hides no
# Task heading leaves the brief complete, so the brief is written with a
# warning. The plan path reaches awk through the environment, not -v, which
# would mangle the backslashes of a Windows path.
#
# This file ships identically in subagent-plan-execution/scripts and
# inline-plan-execution/scripts, so each skill installs on its own. Change
# both copies together.
#
# Usage: task-brief [-C DIR] PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it). -C DIR runs as if started in DIR, as in
# sdd-workspace.
# Exit: 0 brief written; 2 usage, or no git working tree (see sdd-repo);
# 3 task not found; 4 constraints heading cannot be parsed; 5 an unclosed
# code fence hides the end of the task.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = "-C" ]; then
  [ -d "${2:-}" ] || { echo "bad -C directory: ${2:-}" >&2; exit 2; }
  cd "$2"
  shift 2
fi

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief [-C DIR] PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
# The ID names the brief file, so it is held to the task-heading ID grammar.
if ! printf '%s\n' "$n" | grep -Eq '^[A-Za-z0-9]+(\.[A-Za-z0-9]+)*$' \
   || ! printf '%s\n' "$n" | grep -q '[0-9]'; then
  echo "TASK_NUMBER must be a task ID (letters and digits, optionally dot-separated, with at least one digit): $n" >&2
  exit 2
fi

if [ $# -eq 3 ]; then
  out=$3
else
  # Invoke via bash rather than direct exec: some extractors (Python zipfile)
  # strip Unix exec bits when unpacking packaged skills.
  dir=$("${BASH:-bash}" "$here/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

rc=0
TASK_BRIEF_PLAN="$plan" awk -v n="$n" '
  BEGIN { plan = ENVIRON["TASK_BRIEF_PLAN"] }
  function fail(code, msg) {
    print "task-brief: " msg > "/dev/stderr"
    failed = code
    exit code
  }
  function title(line) {
    sub(/^#+[ \t]+/, "", line)
    sub(/[ \t#]+$/, "", line)
    return line
  }
  /^```/ { infence = !infence; if (infence) { fence_line = NR; hidden = 0 } }
  infence && /^#+[ \t]+Task[ \t]/ { hidden = 1 }
  !infence && /^#+[ \t]+/ {
    match($0, /^#+/)
    level = RLENGTH
    istask = 0
    if ($0 ~ /^#+[ \t]+Task[ \t]/) {
      id = $0
      sub(/^#+[ \t]+Task[ \t]+/, "", id)
      if (match(id, /^[A-Za-z0-9]+(\.[A-Za-z0-9]+)*/) && substr(id, 1, RLENGTH) ~ /[0-9]/) {
        istask = 1
        id = substr(id, 1, RLENGTH)
      }
    }
    if (istask) {
      seentask = 1
      tasks++
      incons = 0
      subtask = intask && level > tasklevel && substr(id, 1, length(n)) == n \
        && substr(id, length(n) + 1, 1) ~ /[A-Za-z.]/
      if (!subtask) {
        intask = (id == n)
        tasklevel = level
      }
      if (intask) found = 1
    } else if (!seentask && !(incons && level > conslevel)) {
      # Any heading at or above the constraints heading ends the section;
      # deeper headings are its subsections and stay in it.
      incons = 0
      if (tolower(title($0)) ~ /constraint/) {
        if (tolower(title($0)) != "global constraints")
          fail(4, plan ":" NR ": cannot place constraints heading \"" title($0) "\" (task-brief reads only \"Global Constraints\"); rename it, or fold it into Global Constraints")
        if (hascons)
          fail(4, plan ":" NR ": second \"Global Constraints\" heading (first at line " consline ")")
        hascons = 1
        incons = 1
        conslevel = level
        consline = NR
        next
      }
    }
  }
  !infence && /^#+[ \t]+[^ \t]+[ \t]+[A-Za-z0-9.]*[0-9]/ && shaped < 5 { shaped_heading[++shaped] = $0 }
  # A horizontal rule ends the plan header, and with it the constraints.
  !infence && !seentask && incons && /^(---+|\*\*\*+|___+)[ \t]*$/ { incons = 0 }
  incons {
    cons = cons $0 "\n"
    if ($0 ~ /[^ \t]/) consbody = 1
  }
  intask { task = task $0 "\n" }
  END {
    if (failed) exit failed
    if (hascons && !consbody)
      fail(4, plan ":" consline ": \"Global Constraints\" heading has no content; write \"None\" if the plan has none")
    where = "the code fence opened at line " fence_line " of " plan " never closes"
    if (infence && hidden && (intask || !found)) {
      print "task-brief: " where ", so no Task heading after it can be seen; close that fence in the plan and rerun" > "/dev/stderr"
      if (intask) exit 5
    } else if (infence && intask) {
      print "task-brief: warning: " where "; it hides no Task heading, so this brief is complete" > "/dev/stderr"
    }
    # An open fence that hid Task headings already explains why none were
    # seen; the English-word hint would contradict it.
    if (!tasks && shaped && !(infence && hidden)) {
      print "task-brief: no task headings found. Task headings must use the English word \"Task\" (\"### Task 1: ...\"), even when the rest of the plan is in another language. Headings shaped like tasks:" > "/dev/stderr"
      for (i = 1; i <= shaped; i++) print "  " shaped_heading[i] > "/dev/stderr"
    }
    if (!found) exit 3
    print "## Global Constraints (from the plan; they bind this task)"
    print ""
    if (hascons) {
      sub(/^\n+/, "", cons)
      sub(/\n+$/, "\n", cons)
      printf "%s", cons
    } else {
      print "The plan has no Global Constraints section."
    }
    print ""
    printf "%s", task
  }
' "$plan" > "$out" || rc=$?

if [ "$rc" -ne 0 ]; then
  rm -f "$out"  # leave no partial brief behind to be mistaken for a real one
  if [ "$rc" -eq 3 ]; then
    echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  fi
  exit "$rc"
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
